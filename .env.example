# Ethixweb Environment Variables Example
# Copy this file to .env and provide your actual credentials

# PostgreSQL Database Connection String (Neon, Supabase, or self-hosted)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.region.aws.neon.tech/neondb?sslmode=require

# Protected /admin dashboard secret passcode
ADMIN_SECRET=your_secret_admin_passcode_here
